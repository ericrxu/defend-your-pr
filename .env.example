# Copy to .env in the repository root. Demo Mode needs no credentials.
DARTMOUTH_API_KEY="PASTE_YOUR_DARTMOUTH_API_KEY_HERE"
DARTMOUTH_API_BASE_URL=https://chat.dartmouth.edu/api
# Claude Sonnet 5.5. Confirm this model ID is available to your Dartmouth account.
DARTMOUTH_MODEL=anthropic.claude-sonnet-5-5
# Required for real PR checkpoints: fine-grained PAT for connected repositories,
# with Contents read and Commit statuses write permissions. Demo needs none.
GITHUB_TOKEN=
# Comma-separated public repositories this server is allowed to assess.
OWNIT_REPOSITORIES=
GITHUB_WEBHOOK_SECRET=
# OAuth App credentials verify that the person taking the quiz is the PR author.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OWNIT_APP_URL=http://localhost:3000
OWNIT_API_URL=http://localhost:8000
OWNIT_DB=data/ownit.db
FRONTEND_ORIGIN=http://localhost:3000
# Frontend: copy this setting into frontend/.env.local if changing the API URL.
NEXT_PUBLIC_API_URL=http://localhost:8000
